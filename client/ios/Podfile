# NEW ARCH
# ✅ Enable New Architecture (Fabric + TurboModules)
ENV['RCT_NEW_ARCH_ENABLED'] = '1'
ENV['USE_HERMES'] = '1'

# Speed up spec resolution
source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node (RN hoisting-compatible)
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# 🔧 iOS deployment target (RN 0.80 baseline is iOS 13.4+; we’ll use 15.6)
platform :ios, '15.6'

prepare_react_native_project!

# ⚠️ Avoid dynamic frameworks unless strictly required.
linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'client' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => (ENV['USE_HERMES'] == '1'),
    :fabric_enabled => (ENV['RCT_NEW_ARCH_ENABLED'] == '1'),
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Uncomment if you want Flipper in Debug
  # use_flipper!

  pre_install do |installer|
    # 🔒 Force RN pods to build as static even if use_frameworks! is set
    installer.pod_targets.each do |pod|
      if pod.name.start_with?('React', 'RCT', 'Yoga', 'glog', 'hermes', 'Folly', 'fmt')
        def pod.build_type; Pod::BuildType.static_library end
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 🔒 Enforce iOS 15.6 across Pods + user project
    target_ios = '15.6'
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |bc|
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = target_ios
      end
    end
    installer.aggregate_targets.each do |agg|
      agg.user_project.build_configurations.each do |bc|
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = target_ios
      end
    end
  end
end



